generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model katalog_data_2d {
  data_2d_id  String   @id(map: "katalog_data_pk") @db.VarChar(50)
  layer_name  String?  @db.VarChar(50)
  akses       String?  @db.VarChar(50)
  is_editable Boolean?
  wms_url     String?  @db.VarChar(64)
  wfs_url     String?  @db.VarChar(256)
  author      String?  @db.VarChar(50)
  users       users?   @relation(fields: [author], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "katalog_data_users_fk")
}

model users {
  user_id         String            @id(map: "users_pk") @db.VarChar
  email           String            @unique(map: "users_uniqe") @db.VarChar
  password        String?           @db.VarChar
  is_active       Boolean?
  role            String?           @db.VarChar
  nama            String?           @db.VarChar
  katalog_data_2d katalog_data_2d[]
}
